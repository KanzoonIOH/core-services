# =============================================================================
# core-services/.env.example — LOCAL DEV ONLY.
#
# Copy to .env to run the Go service on the HOST (`make dev` / `make timer`)
# against the dockerized deps started by `make deps` at the repo root.
# Values point at the PUBLISHED HOST PORTS in the root .env.
#
# Docker/deploy does NOT read this file — the root docker-compose.yml injects
# everything from the root .env (single source of truth).
# =============================================================================

# App
SERVER_PORT=6767

# Postgres (host port 6760)
DB_USER=postgres
DB_PASSWORD=postgres
DB_PASSWORD_ENCODED=postgres
DB_NAME=aic3
DB_URL=postgres://postgres:postgres@localhost:6760/aic3?sslmode=disable

# ClickHouse (native host port 6771)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=6771
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=aic3
CLICKHOUSE_URL=clickhouse://localhost:6771/aic3?username=default&password=clickhouse

# Redpanda (host port 6763)
REDPANDA_BROKER=localhost:6763
REDPANDA_SCHEMA_REGISTRY=http://localhost:6763
REDPANDA_ADMIN_URL=http://localhost:6763

# Redis (host port 6762)
REDIS_URL=redis://localhost:6762

# S3 object storage / MinIO (host port 6765)
S3_ENDPOINT=http://localhost:6765
S3_PUBLIC_ENDPOINT=http://localhost:6765
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aic3

# Auth
JWT_SECRET=replace_me_with_a_long_random_secret
SECRET_ISSUER=aic3-service
ACCESS_TOKEN_TTL_DAYS=14

# CORS / app URLs (web-app dev server)
ALLOWED_ORIGINS=http://localhost:6766,http://localhost:5173
APP_URL=http://localhost:6766

# Email (Resend)
RESEND_API_KEY=copy_your_resend_api_key_here
RESEND_FROM=noreply@yourdomain.com
