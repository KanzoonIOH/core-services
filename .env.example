# Application
SERVER_PORT=8888

# Docker database container
DB_CONTAINER=aiac-postgres

# Database connection parts
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aiac
DB_SSLMODE=disable
# Manually put encoded db password for special chars
# if no special chars, duplicate the password
DB_PASSWORD_ENCODED=postgres
DB_URL=postgres://${DB_USER}:${DB_PASSWORD_ENCODED}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSLMODE}

# Auth
# Generate a strong secret with: openssl rand -base64 48
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_ISSUER=aiac-service
# Access token TTL in minutes (short-lived)
ACCESS_TOKEN_TTL_DAYS=14

# CORS
# Comma-separated list of allowed origins (full scheme+host, no trailing slash).
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# Email (Resend)
RESEND_API_KEY=copy_your_resend_api_key_here
# Sender address (must be a verified domain in Resend)
RESEND_FROM=noreply@yourdomain.com
# Frontend base URL used in email links
APP_URL=http://localhost:3000

# ClickHouse (Dokploy — set host to your server IP)
CLICKHOUSE_HOST=your.server.ip
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=set_a_strong_password
CLICKHOUSE_DATABASE=aiac
CLICKHOUSE_URL=clickhouse://${CLICKHOUSE_HOST}:${CLICKHOUSE_PORT}/${CLICKHOUSE_DATABASE}?username=${CLICKHOUSE_USER}&password=${CLICKHOUSE_PASSWORD}

# Redpanda (Dokploy — set host to your server IP)
REDPANDA_HOST=your.server.ip
REDPANDA_BROKER=${REDPANDA_HOST}:19092
REDPANDA_SCHEMA_REGISTRY=http://${REDPANDA_HOST}:18081
REDPANDA_ADMIN_URL=http://${REDPANDA_HOST}:9644

# Redis (conversation session store — managed by the AI engineer team)
REDIS_URL=redis://localhost:6379
