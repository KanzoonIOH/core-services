# =============================================================================
# service/.env.compose
# Backend env for running under docker-compose (the root docker-compose.yml).
# Hostnames point at compose SERVICE NAMES on the shared aiac-net network,
# NOT localhost. Loaded into api-service and timer-service via `env_file:`.
#
# Secrets below are placeholders — replace before any real deployment.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
# Port the API binds to INSIDE the container. Must equal SERVER_PORT in root .env
# (which controls the host->container publish mapping). Keep both in sync.
SERVER_PORT=6767

# ── Postgres (service name: postgres, internal port 5432) ────────────────────
# DB_USER / DB_PASSWORD / DB_NAME MUST match the same vars in root .env
# (root inits the postgres container; these authenticate the app to it).
# NOTE: DB_URL uses the INTERNAL port 5432 + service name `postgres`, NOT the
# host-published DB_PORT (6768). Do not change 5432 here.
DB_USER=postgres
DB_PASSWORD=postgres
# URL-encoded password (same as DB_PASSWORD when no special chars)
DB_PASSWORD_ENCODED=postgres
DB_NAME=aiac
DB_URL=postgres://postgres:postgres@postgres:5432/aiac?sslmode=disable

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong secret with: openssl rand -base64 48
JWT_SECRET=replace_me_with_a_long_random_secret
# NOTE: code reads SECRET_ISSUER (not JWT_ISSUER).
SECRET_ISSUER=aiac-service
ACCESS_TOKEN_TTL_DAYS=14

# ── CORS ─────────────────────────────────────────────────────────────────────
# Full scheme+host, no trailing slash, comma-separated.
# MUST include the host origin the SPA is served from = http://localhost:${WEB_PORT}.
# WEB_PORT is currently 6766 (see root .env). :5173 kept for local `pnpm dev`.
ALLOWED_ORIGINS=http://localhost:6766,http://localhost:5173

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=copy_your_resend_api_key_here
RESEND_FROM=noreply@yourdomain.com
# Frontend base URL used in email links (host-reachable = http://localhost:${WEB_PORT}).
APP_URL=http://localhost:6766

# ── ClickHouse (service name: clickhouse, native port 9000) ──────────────────
# CLICKHOUSE_USER/PASSWORD/DATABASE MUST match the same vars in root .env.
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=aiac
CLICKHOUSE_URL=clickhouse://clickhouse:9000/aiac?username=default&password=clickhouse

# ── Redpanda (service name: redpanda, internal Kafka port 9092) ──────────────
REDPANDA_BROKER=redpanda:9092
REDPANDA_SCHEMA_REGISTRY=http://redpanda:8081
REDPANDA_ADMIN_URL=http://redpanda:9644

# ── Timer service (cmd/timer) — all optional, defaults shown ─────────────────
# TIMER_CONVERSATION_TIMEOUT=10s
# TIMER_POLL_INTERVAL=500ms
# TIMER_EVENT_BUFFER=256
# TIMER_POLL_BATCH=100
# TIMER_DEDUPE_TTL=10m

# ── Redis (service name: redis, internal port 6379) ──────────────────────────
REDIS_URL=redis://redis:6379

# ── RustFS / S3 object storage (service name: rustfs, internal port 9000) ────
RUSTFS_ENDPOINT=http://rustfs:9000
# Host-reachable URL for source_uri links shown in the browser.
# RustFS is NOT published to the host in this setup; set this to a reachable
# URL (e.g. via a proxy) if the frontend must load stored files directly.
RUSTFS_PUBLIC_ENDPOINT=http://rustfs:9000
RUSTFS_REGION=us-east-1
# RUSTFS_ACCESS_KEY/SECRET_KEY MUST match the same vars in root .env.
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=aiac
